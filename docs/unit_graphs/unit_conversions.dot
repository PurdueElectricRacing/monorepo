digraph "unit_conversions.dot" {
	rankdir=TB;
	pack=true;
	packmode="array_u5";
	graph [fontname="Helvetica", labelloc="t", bgcolor="transparent", fontcolor="#8A8A8A", label="DearUnits Conversions"];
	node [fontname="Helvetica", shape=box, style="filled,rounded", color="#777777", fontcolor="#111111"];
	edge [fontname="Helvetica", color="#777777", fontcolor="#8A8A8A"];

	"quantity:angle" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>angle</B></TD></TR><TR><TD ALIGN="LEFT"><B>radian</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">degree</TD><TD ALIGN="RIGHT">×0.0174533</TD></TR><TR><TD ALIGN="LEFT">revolution</TD><TD ALIGN="RIGHT">×6.28319</TD></TR></TABLE>>, fillcolor="#B8D6EF", sortv=0];
	"quantity:current" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>current</B></TD></TR><TR><TD ALIGN="LEFT"><B>amp</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">milliamp</TD><TD ALIGN="RIGHT">×0.001</TD></TR></TABLE>>, fillcolor="#B8D6EF", sortv=1];
	"quantity:length" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>length</B></TD></TR><TR><TD ALIGN="LEFT"><B>meter</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">centimeter</TD><TD ALIGN="RIGHT">×0.01</TD></TR><TR><TD ALIGN="LEFT">foot</TD><TD ALIGN="RIGHT">×0.3048</TD></TR><TR><TD ALIGN="LEFT">inch</TD><TD ALIGN="RIGHT">×0.0254</TD></TR><TR><TD ALIGN="LEFT">kilometer</TD><TD ALIGN="RIGHT">×1000</TD></TR><TR><TD ALIGN="LEFT">mile</TD><TD ALIGN="RIGHT">×1609.34</TD></TR><TR><TD ALIGN="LEFT">millimeter</TD><TD ALIGN="RIGHT">×0.001</TD></TR></TABLE>>, fillcolor="#B8D6EF", sortv=2];
	"quantity:mass" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>mass</B></TD></TR><TR><TD ALIGN="LEFT"><B>kilogram</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">gram</TD><TD ALIGN="RIGHT">×0.001</TD></TR><TR><TD ALIGN="LEFT">pound</TD><TD ALIGN="RIGHT">×0.453592</TD></TR></TABLE>>, fillcolor="#B8D6EF", sortv=3];
	"quantity:temperature" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>temperature</B></TD></TR><TR><TD ALIGN="LEFT"><B>celsius</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">fahrenheit</TD><TD ALIGN="RIGHT">×0.555556 − 17.7778</TD></TR></TABLE>>, fillcolor="#B8D6EF", sortv=4];
	"quantity:time" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>time</B></TD></TR><TR><TD ALIGN="LEFT"><B>second</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">day</TD><TD ALIGN="RIGHT">×86400</TD></TR><TR><TD ALIGN="LEFT">hour</TD><TD ALIGN="RIGHT">×3600</TD></TR><TR><TD ALIGN="LEFT">millisecond</TD><TD ALIGN="RIGHT">×0.001</TD></TR><TR><TD ALIGN="LEFT">minute</TD><TD ALIGN="RIGHT">×60</TD></TR></TABLE>>, fillcolor="#B8D6EF", sortv=5];
	"quantity:acceleration" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>acceleration</B></TD></TR><TR><TD ALIGN="LEFT"><B>meters_per_second_squared</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">standard_gravity</TD><TD ALIGN="RIGHT">×9.80665</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=6];
	"quantity:angular_velocity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>angular_velocity</B></TD></TR><TR><TD ALIGN="LEFT"><B>radians_per_second</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">degrees_per_second</TD><TD ALIGN="RIGHT">×0.0174533</TD></TR><TR><TD ALIGN="LEFT">revolutions_per_minute</TD><TD ALIGN="RIGHT">×0.10472</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=7];
	"quantity:area" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>area</B></TD></TR><TR><TD ALIGN="LEFT"><B>square_meter</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">square_centimeter</TD><TD ALIGN="RIGHT">×0.0001</TD></TR><TR><TD ALIGN="LEFT">square_millimeter</TD><TD ALIGN="RIGHT">×1e-06</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=8];
	"quantity:charge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>charge</B></TD></TR><TR><TD ALIGN="LEFT"><B>coulomb</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">amp_hour</TD><TD ALIGN="RIGHT">×3600</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=9];
	"quantity:energy" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>energy</B></TD></TR><TR><TD ALIGN="LEFT"><B>joule</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">kilowatt_hour</TD><TD ALIGN="RIGHT">×3.6e+06</TD></TR><TR><TD ALIGN="LEFT">watt_hour</TD><TD ALIGN="RIGHT">×3600</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=10];
	"quantity:force" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>force</B></TD></TR><TR><TD ALIGN="LEFT"><B>newton</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">pound_force</TD><TD ALIGN="RIGHT">×4.44822</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=11];
	"quantity:frequency" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>frequency</B></TD></TR><TR><TD ALIGN="LEFT"><B>hertz</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">kilohertz</TD><TD ALIGN="RIGHT">×1000</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=12];
	"quantity:power" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>power</B></TD></TR><TR><TD ALIGN="LEFT"><B>watt</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">kilowatt</TD><TD ALIGN="RIGHT">×1000</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=13];
	"quantity:pressure" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>pressure</B></TD></TR><TR><TD ALIGN="LEFT"><B>pascal</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">bar</TD><TD ALIGN="RIGHT">×100000</TD></TR><TR><TD ALIGN="LEFT">kilopascal</TD><TD ALIGN="RIGHT">×1000</TD></TR><TR><TD ALIGN="LEFT">pound_per_square_inch</TD><TD ALIGN="RIGHT">×6894.76</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=14];
	"quantity:resistance" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>resistance</B></TD></TR><TR><TD ALIGN="LEFT"><B>ohm</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">kiloohm</TD><TD ALIGN="RIGHT">×1000</TD></TR><TR><TD ALIGN="LEFT">milliohm</TD><TD ALIGN="RIGHT">×0.001</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=15];
	"quantity:torque" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>torque</B></TD></TR><TR><TD ALIGN="LEFT"><B>newton_meter</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">pound_foot</TD><TD ALIGN="RIGHT">×1.35582</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=16];
	"quantity:velocity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>velocity</B></TD></TR><TR><TD ALIGN="LEFT"><B>meters_per_second</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">kilometers_per_hour</TD><TD ALIGN="RIGHT">×0.277778</TD></TR><TR><TD ALIGN="LEFT">miles_per_hour</TD><TD ALIGN="RIGHT">×0.44704</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=17];
	"quantity:voltage" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD COLSPAN="2"><B>voltage</B></TD></TR><TR><TD ALIGN="LEFT"><B>volt</B></TD><TD ALIGN="RIGHT">base</TD></TR><TR><TD ALIGN="LEFT">millivolt</TD><TD ALIGN="RIGHT">×0.001</TD></TR></TABLE>>, fillcolor="#D5EBC8", sortv=18];
}
