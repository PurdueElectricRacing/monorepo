digraph "unit_relations.dot" {
	rankdir=LR;
	graph [fontname="Helvetica", labelloc="t", bgcolor="transparent", fontcolor="#8A8A8A", label="DearUnits Relations"];
	node [fontname="Helvetica", shape=box, style="filled,rounded", color="#777777", fontcolor="#111111"];
	edge [fontname="Helvetica", color="#B5562F", fontcolor="#8A8A8A"];

	"quantity:angular_velocity" [label="angular_velocity", fillcolor="#D5EBC8"];
	"quantity:charge" [label="charge", fillcolor="#D5EBC8"];
	"quantity:energy" [label="energy", fillcolor="#D5EBC8"];
	"quantity:force" [label="force", fillcolor="#D5EBC8"];
	"quantity:frequency" [label="frequency", fillcolor="#D5EBC8"];
	"quantity:length" [label="length", fillcolor="#B8D6EF"];
	"quantity:power" [label="power", fillcolor="#D5EBC8"];
	"quantity:time" [label="time", fillcolor="#B8D6EF"];
	"quantity:torque" [label="torque", fillcolor="#D5EBC8"];
	"quantity:velocity" [label="velocity", fillcolor="#D5EBC8"];
	"quantity:voltage" [label="voltage", fillcolor="#D5EBC8"];

	"relation:0" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#B5562F", fontcolor="#B5562F"];
	"quantity:angular_velocity" -> "relation:0" [arrowhead=none];
	"quantity:length" -> "relation:0" [arrowhead=none];
	"relation:0" -> "quantity:velocity";
	"relation:1" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#B5562F", fontcolor="#B5562F"];
	"quantity:force" -> "relation:1" [arrowhead=none];
	"quantity:length" -> "relation:1" [arrowhead=none];
	"relation:1" -> "quantity:torque";
	"relation:2" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#B5562F", fontcolor="#B5562F"];
	"quantity:torque" -> "relation:2" [arrowhead=none];
	"quantity:angular_velocity" -> "relation:2" [arrowhead=none];
	"relation:2" -> "quantity:power";
	"relation:3" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#B5562F", fontcolor="#B5562F"];
	"quantity:power" -> "relation:3" [arrowhead=none];
	"quantity:time" -> "relation:3" [arrowhead=none];
	"relation:3" -> "quantity:energy";
	"relation:4" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#B5562F", fontcolor="#B5562F"];
	"quantity:charge" -> "relation:4" [arrowhead=none];
	"quantity:voltage" -> "relation:4" [arrowhead=none];
	"relation:4" -> "quantity:energy";
	"relation:5" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#B5562F", fontcolor="#B5562F"];
	"quantity:energy" -> "relation:5" [arrowhead=none];
	"quantity:frequency" -> "relation:5" [arrowhead=none];
	"relation:5" -> "quantity:power";
}
