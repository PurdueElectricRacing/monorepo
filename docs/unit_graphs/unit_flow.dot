digraph "unit_flow.dot" {
	rankdir=LR;
	graph [fontname="Helvetica", labelloc="t", bgcolor="transparent", fontcolor="#8A8A8A", label="DearUnits Flow"];
	node [fontname="Helvetica", shape=box, style="filled,rounded", color="#777777", fontcolor="#111111"];
	edge [fontname="Helvetica", color="#2F70AD", fontcolor="#8A8A8A"];
	nodesep=0.3;
	ranksep=0.8;

	"quantity:angle" [label=<<B>angle</B><BR/>radian>, fillcolor="#B8D6EF"];
	"unit:angle:degree" [label="degree", fillcolor="white"];
	"unit:angle:degree" -> "quantity:angle" [label="×0.0174533", color="#777777", tailport=e, headport=w];
	"unit:angle:revolution" [label="revolution", fillcolor="white"];
	"unit:angle:revolution" -> "quantity:angle" [label="×6.28319", color="#777777", tailport=e, headport=w];
	"quantity:current" [label=<<B>current</B><BR/>amp>, fillcolor="#B8D6EF"];
	"unit:current:milliamp" [label="milliamp", fillcolor="white"];
	"unit:current:milliamp" -> "quantity:current" [label="×0.001", color="#777777", tailport=e, headport=w];
	"quantity:length" [label=<<B>length</B><BR/>meter>, fillcolor="#B8D6EF"];
	"unit:length:centimeter" [label="centimeter", fillcolor="white"];
	"unit:length:centimeter" -> "quantity:length" [label="×0.01", color="#777777", tailport=e, headport=w];
	"unit:length:foot" [label="foot", fillcolor="white"];
	"unit:length:foot" -> "quantity:length" [label="×0.3048", color="#777777", tailport=e, headport=w];
	"unit:length:inch" [label="inch", fillcolor="white"];
	"unit:length:inch" -> "quantity:length" [label="×0.0254", color="#777777", tailport=e, headport=w];
	"unit:length:kilometer" [label="kilometer", fillcolor="white"];
	"unit:length:kilometer" -> "quantity:length" [label="×1000", color="#777777", tailport=e, headport=w];
	"unit:length:mile" [label="mile", fillcolor="white"];
	"unit:length:mile" -> "quantity:length" [label="×1609.34", color="#777777", tailport=e, headport=w];
	"unit:length:millimeter" [label="millimeter", fillcolor="white"];
	"unit:length:millimeter" -> "quantity:length" [label="×0.001", color="#777777", tailport=e, headport=w];
	"quantity:mass" [label=<<B>mass</B><BR/>kilogram>, fillcolor="#B8D6EF"];
	"unit:mass:gram" [label="gram", fillcolor="white"];
	"unit:mass:gram" -> "quantity:mass" [label="×0.001", color="#777777", tailport=e, headport=w];
	"unit:mass:pound" [label="pound", fillcolor="white"];
	"unit:mass:pound" -> "quantity:mass" [label="×0.453592", color="#777777", tailport=e, headport=w];
	"quantity:temperature" [label=<<B>temperature</B><BR/>celsius>, fillcolor="#B8D6EF"];
	"unit:temperature:fahrenheit" [label="fahrenheit", fillcolor="white"];
	"unit:temperature:fahrenheit" -> "quantity:temperature" [label="×0.555556 − 17.7778", color="#777777", tailport=e, headport=w];
	"quantity:time" [label=<<B>time</B><BR/>second>, fillcolor="#B8D6EF"];
	"unit:time:day" [label="day", fillcolor="white"];
	"unit:time:day" -> "quantity:time" [label="×86400", color="#777777", tailport=e, headport=w];
	"unit:time:hour" [label="hour", fillcolor="white"];
	"unit:time:hour" -> "quantity:time" [label="×3600", color="#777777", tailport=e, headport=w];
	"unit:time:millisecond" [label="millisecond", fillcolor="white"];
	"unit:time:millisecond" -> "quantity:time" [label="×0.001", color="#777777", tailport=e, headport=w];
	"unit:time:minute" [label="minute", fillcolor="white"];
	"unit:time:minute" -> "quantity:time" [label="×60", color="#777777", tailport=e, headport=w];
	{ rank=same; "quantity:angle"; "quantity:current"; "quantity:length"; "quantity:mass"; "quantity:temperature"; "quantity:time"; }
	"quantity:acceleration" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>acceleration</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>meters_per_second_squared</B></TD></TR><TR><TD ALIGN="LEFT">standard_gravity</TD><TD ALIGN="RIGHT">×9.80665</TD></TR></TABLE>>, shape=plain];
	"quantity:angular_velocity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>angular_velocity</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>radians_per_second</B></TD></TR><TR><TD ALIGN="LEFT">degrees_per_second</TD><TD ALIGN="RIGHT">×0.0174533</TD></TR><TR><TD ALIGN="LEFT">revolutions_per_minute</TD><TD ALIGN="RIGHT">×0.10472</TD></TR></TABLE>>, shape=plain];
	"quantity:area" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>area</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>square_meter</B></TD></TR><TR><TD ALIGN="LEFT">square_centimeter</TD><TD ALIGN="RIGHT">×0.0001</TD></TR><TR><TD ALIGN="LEFT">square_millimeter</TD><TD ALIGN="RIGHT">×1e-06</TD></TR></TABLE>>, shape=plain];
	"quantity:charge" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>charge</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>coulomb</B></TD></TR><TR><TD ALIGN="LEFT">amp_hour</TD><TD ALIGN="RIGHT">×3600</TD></TR></TABLE>>, shape=plain];
	"quantity:energy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>energy</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>joule</B></TD></TR><TR><TD ALIGN="LEFT">kilowatt_hour</TD><TD ALIGN="RIGHT">×3.6e+06</TD></TR><TR><TD ALIGN="LEFT">watt_hour</TD><TD ALIGN="RIGHT">×3600</TD></TR></TABLE>>, shape=plain];
	"quantity:force" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>force</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>newton</B></TD></TR><TR><TD ALIGN="LEFT">pound_force</TD><TD ALIGN="RIGHT">×4.44822</TD></TR></TABLE>>, shape=plain];
	"quantity:frequency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>frequency</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>hertz</B></TD></TR><TR><TD ALIGN="LEFT">kilohertz</TD><TD ALIGN="RIGHT">×1000</TD></TR></TABLE>>, shape=plain];
	"quantity:power" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>power</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>watt</B></TD></TR><TR><TD ALIGN="LEFT">kilowatt</TD><TD ALIGN="RIGHT">×1000</TD></TR></TABLE>>, shape=plain];
	"quantity:pressure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>pressure</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>pascal</B></TD></TR><TR><TD ALIGN="LEFT">bar</TD><TD ALIGN="RIGHT">×100000</TD></TR><TR><TD ALIGN="LEFT">kilopascal</TD><TD ALIGN="RIGHT">×1000</TD></TR><TR><TD ALIGN="LEFT">pound_per_square_inch</TD><TD ALIGN="RIGHT">×6894.76</TD></TR></TABLE>>, shape=plain];
	"quantity:resistance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>resistance</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>ohm</B></TD></TR><TR><TD ALIGN="LEFT">kiloohm</TD><TD ALIGN="RIGHT">×1000</TD></TR><TR><TD ALIGN="LEFT">milliohm</TD><TD ALIGN="RIGHT">×0.001</TD></TR></TABLE>>, shape=plain];
	"quantity:torque" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>torque</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>newton_meter</B></TD></TR><TR><TD ALIGN="LEFT">pound_foot</TD><TD ALIGN="RIGHT">×1.35582</TD></TR></TABLE>>, shape=plain];
	"quantity:velocity" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>velocity</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>meters_per_second</B></TD></TR><TR><TD ALIGN="LEFT">kilometers_per_hour</TD><TD ALIGN="RIGHT">×0.277778</TD></TR><TR><TD ALIGN="LEFT">miles_per_hour</TD><TD ALIGN="RIGHT">×0.44704</TD></TR></TABLE>>, shape=plain];
	"quantity:voltage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" STYLE="rounded" BGCOLOR="white" COLOR="#777777"><TR><TD COLSPAN="2" BORDER="0"><B>voltage</B></TD></TR><TR><TD PORT="hub" COLSPAN="2" BGCOLOR="#D5EBC8"><B>volt</B></TD></TR><TR><TD ALIGN="LEFT">millivolt</TD><TD ALIGN="RIGHT">×0.001</TD></TR></TABLE>>, shape=plain];

	"op:acceleration" [label="÷", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:velocity":hub:e -> "op:acceleration" [arrowhead=none];
	"quantity:time":e -> "op:acceleration" [arrowhead=none, style=dashed];
	"op:acceleration" -> "quantity:acceleration":hub:w;
	"op:angular_velocity" [label="÷", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:angle":e -> "op:angular_velocity" [arrowhead=none];
	"quantity:time":e -> "op:angular_velocity" [arrowhead=none, style=dashed];
	"op:angular_velocity" -> "quantity:angular_velocity":hub:w;
	"quantity:length":e -> "quantity:area":hub:w [label="2"];
	"op:charge" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:current":e -> "op:charge" [arrowhead=none];
	"quantity:time":e -> "op:charge" [arrowhead=none];
	"op:charge" -> "quantity:charge":hub:w;
	"op:energy" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:power":hub:e -> "op:energy" [arrowhead=none];
	"quantity:time":e -> "op:energy" [arrowhead=none];
	"op:energy" -> "quantity:energy":hub:w;
	"op:force" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:acceleration":hub:e -> "op:force" [arrowhead=none];
	"quantity:mass":e -> "op:force" [arrowhead=none];
	"op:force" -> "quantity:force":hub:w;
	"quantity:time":e -> "quantity:frequency":hub:w [label="-1"];
	"op:power" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:force":hub:e -> "op:power" [arrowhead=none];
	"quantity:velocity":hub:e -> "op:power" [arrowhead=none];
	"op:power" -> "quantity:power":hub:w;
	"op:pressure" [label="÷", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:force":hub:e -> "op:pressure" [arrowhead=none];
	"quantity:area":hub:e -> "op:pressure" [arrowhead=none, style=dashed];
	"op:pressure" -> "quantity:pressure":hub:w;
	"op:resistance" [label="÷", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:voltage":hub:e -> "op:resistance" [arrowhead=none];
	"quantity:current":e -> "op:resistance" [arrowhead=none, style=dashed];
	"op:resistance" -> "quantity:resistance":hub:w;
	"op:torque" [label="×", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:force":hub:e -> "op:torque" [arrowhead=none];
	"quantity:length":e -> "op:torque" [arrowhead=none];
	"op:torque" -> "quantity:torque":hub:w;
	"op:velocity" [label="÷", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:length":e -> "op:velocity" [arrowhead=none];
	"quantity:time":e -> "op:velocity" [arrowhead=none, style=dashed];
	"op:velocity" -> "quantity:velocity":hub:w;
	"op:voltage" [label="÷", shape=circle, style=filled, width=0.3, fixedsize=true, fillcolor="white", color="#2F70AD", fontcolor="#2F70AD"];
	"quantity:power":hub:e -> "op:voltage" [arrowhead=none];
	"quantity:current":e -> "op:voltage" [arrowhead=none, style=dashed];
	"op:voltage" -> "quantity:voltage":hub:w;
}
