{
    "node_name": "BL_PDU",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "bl_pdu_resp",
                    "description": "CAN bootloader response for PDU",
                    "signals": [
                        {"signal_name": "status", "data_type": "bootloader_status_t"},
                        {"signal_name": "detail", "data_type": "uint32_t"}
                    ],
                    "id_override": "0x040",
                    "priority": 0
                },
                {
                    "message_name": "bl_pdu_info",
                    "description": "CAN bootloader identity and capabilities for PDU",
                    "signals": [
                        {"signal_name": "protocol_version", "data_type": "uint8_t"},
                        {"signal_name": "git_hash", "data_type": "uint32_t"},
                        {"signal_name": "target_id", "data_type": "bootloader_target_id_t"},
                        {"signal_name": "flags", "data_type": "uint8_t"}
                    ],
                    "id_override": "0x106",
                    "period_ms": 5000,
                    "priority": 4
                }
            ],
            "rx": [
                {"message_name": "bl_pdu_start"},
                {"message_name": "bl_pdu_crc"},
                {"message_name": "bl_pdu_jump"},
                {"message_name": "bl_pdu_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
