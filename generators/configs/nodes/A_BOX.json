                        {
                            "signal_name": "is_board_temp",
                            "description": "Whether this thermistor is an onboard BMS sensor rather than a cell sensor",
                            "data_type": "bool"
                        }
                    ],
                    "priority": 5,
                    "period_ms": 125
                }
