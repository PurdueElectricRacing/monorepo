{
    "node_name": "A_BOX",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "abox_init",
                    "description": "ABOX hardware initialized",
                    "signals": [
                        {
                            "signal_name": "csr",
                            "description": "RCC CSR register",
                            "data_type": "uint32_t"
                        }
                    ],
                    "priority": 0
                },
                {
                    "message_name": "pack_analog",
                    "description": "Pack voltage and current from analog readings",
                    "signals": [
                        {
                            "signal_name": "pack_voltage",
                            "description": "Total pack voltage",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.01,
                            "min": 362.5,
                            "max": 609
                        },
                        {
                            "signal_name": "pack_current",
                            "description": "Total pack current, positive is discharge",
                            "data_type": "int16_t",
                            "unit": "A",
                            "scale": 0.1,
                            "min": -250,
                            "max": 250
                        }
                    ],
                    "priority": 5,
                    "period_ms": 10
                },
                {
                    "message_name": "bms_voltages",
                    "description": "Cell voltage statistics from BMS",
                    "signals": [
                        {
                            "signal_name": "pack_voltage",
                            "description": "Total pack voltage",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.01,
                            "min": 362.5,
                            "max": 609
                        },
                        {
                            "signal_name": "min_cell_voltage",
                            "description": "Minimum cell voltage in the pack",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.01,
                            "min": 2.5,
                            "max": 4.2
                        },
                        {
                            "signal_name": "max_cell_voltage",
                            "description": "Maximum cell voltage in the pack",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.01,
                            "min": 2.5,
                            "max": 4.2
                        },
                        {
                            "signal_name": "avg_cell_voltage",
                            "description": "Average cell voltage in the pack",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.01,
                            "min": 2.5,
                            "max": 4.2
                        }
                    ],
                    "priority": 1,
                    "period_ms": 200
                },
                {
                    "message_name": "bms_temps",
                    "description": "Cell and onboard temperature statistics from BMS",
                    "signals": [
                        {
                            "signal_name": "min_cell_temp",
                            "description": "Minimum cell temperature in the pack",
                            "data_type": "uint8_t",
                            "unit": "C",
                            "min": 0,
                            "max": 80
                        },
                        {
                            "signal_name": "max_cell_temp",
                            "description": "Maximum cell temperature in the pack",
                            "data_type": "uint8_t",
                            "unit": "C",
                            "min": 0,
                            "max": 80
                        },
                        {
                            "signal_name": "avg_cell_temp",
                            "description": "Average cell temperature in the pack",
                            "data_type": "uint8_t",
                            "unit": "C",
                            "min": 0,
                            "max": 80
                        },
                        {
                            "signal_name": "min_board_temp",
                            "description": "Minimum onboard BMS temperature in the pack",
                            "data_type": "uint8_t",
                            "unit": "C",
                            "min": 0,
                            "max": 80
                        },
                        {
                            "signal_name": "max_board_temp",
                            "description": "Maximum onboard BMS temperature in the pack",
                            "data_type": "uint8_t",
                            "unit": "C",
                            "min": 0,
                            "max": 80
                        },
                        {
                            "signal_name": "avg_board_temp",
                            "description": "Average onboard BMS temperature in the pack",
                            "data_type": "uint8_t",
                            "unit": "C",
                            "min": 0,
                            "max": 80
                        }
                    ],
                    "priority": 1,
                    "period_ms": 200
                },
                {
                    "message_name": "abox_version",
                    "description": "ABox version",
                    "signals": [
                        {
                            "signal_name": "git_hash",
                            "data_type": "uint32_t",
                            "length": 28,
                            "display_format": "hex"
                        },
                        {
                            "signal_name": "bootloader_git_hash",
                            "data_type": "uint32_t",
                            "length": 28
                        },
                        {
                            "signal_name": "bootloadable",
                            "data_type": "bool"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                }
            ],
            "rx": [
                {
                    "message_name": "bl_a_box_start",
                    "callback": true
                }
            ],
            "accept_all_messages": false
        },
        "CCAN": {
            "peripheral": "FDCAN2",
