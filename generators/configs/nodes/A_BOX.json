                            "signal_name": "voltage",
                            "description": "individual cell voltage",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.01,
                            "min": 2.5,
                            "max": 4.2
                        },
                        {
                            "signal_name": "module_num",
                            "description": "Module number of the cell being reported, 0 indexed",
                            "data_type": "uint8_t",
                            "min": 0,
                            "max": 4
                        },
                        {
                            "signal_name": "cell_num",
                            "description": "Cell number within the module, 0 indexed",
                            "data_type": "uint8_t",
                            "min": 0,
                            "max": 28
