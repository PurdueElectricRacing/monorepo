                {
                    "message_name": "elcon_command",
                    "description": "Command from A_BOX to Elcon Charger (Message1)",
                    "byte_order": "big_endian",
                    "signals": [
                        {
                            "signal_name": "voltage_limit",
                            "description": "Requested charge voltage in decivolts",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "current_limit",
                            "description": "Requested charge current in deciamps",
                            "data_type": "uint16_t",
                            "unit": "A",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "charger_disable",
                            "description": "0 to enable charging, 1 to disable charging",
                            "data_type": "uint8_t",
                            "choices": ["ENABLE", "DISABLE"]
                        },
                        {
                            "signal_name": "reserved1",
                            "data_type": "uint8_t"
                        },
                        {
                            "signal_name": "reserved2",
                            "data_type": "uint8_t"
                        },
                        {
                            "signal_name": "reserved3",
                            "data_type": "uint8_t"
                        }
                    ],
                    "priority": 3,
                    "id_override": "0x1806E5F4",
                    "period_ms": 1000
                },
                {
                    "message_name": "charging_fsm_internals",
                    "description": "Internal states of the charging FSM for debugging purposes",
                    "signals": [
                        {
                            "signal_name": "voltage_limit",
                            "description": "Requested charge voltage in decivolts",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "current_limit",
                            "description": "Requested charge current in deciamps",
                            "data_type": "uint16_t",
                            "unit": "A",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "balancing_status",
                            "description": "Balancing status of the pack",
                            "data_type": "bool"
                        },
                        {
                            "signal_name": "charging_state",
                            "description": "abox charging fsm state",
                            "data_type": "charging_state_t"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 1000
                },
