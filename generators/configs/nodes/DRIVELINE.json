{
    "node_name": "DRIVELINE",
    "busses": {
        "SCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "front_driveline_init",
                    "description": "Front driveline hardware initialized",
                    "signals": [
                        {
                            "signal_name": "csr",
                            "description": "RCC CSR register",
                            "data_type": "uint32_t"
                        }
                    ],
                    "priority": 3
                },
                {
                    "message_name": "rear_driveline_init",
                    "description": "Front driveline hardware initialized",
                    "signals": [
                        {
                            "signal_name": "csr",
                            "description": "RCC CSR register",
                            "data_type": "uint32_t"
                        }
                    ],
                    "priority": 3
                },
                {
                    "message_name": "front_shockpots",
                    "description": "Shockpot readings from front left and front right",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Length of front left shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Length of front right shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        }
                    ],
                    "priority": 5,
                    "period_ms": 10
                },
                {
                    "message_name": "rear_shockpots",
                    "description": "Shockpot readings from rear left and rear right",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Length of rear left shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Length of rear right shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        }
                    ],
                    "priority": 5,
                    "period_ms": 10
                },
                {
                    "message_name": "front_oil_temps",
                    "description": "oil temps from front",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Oil temp in front left gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Oil temp in front right gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        }
                    ],
                    "priority": 4,
                    "period_ms": 4000
                },
                {
                    "message_name": "rear_oil_temps",
                    "description": "oil temps from rear",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Oil temp in rear left gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Oil temp in rear right gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        }
                    ],
                    "priority": 4,
                    "period_ms": 4000
                },
                {
                    "message_name": "front_driveline_version",
                    "description": "Front Driveline Version",
                    "signals": [
                        {
                            "signal_name": "git_hash",
                            "data_type": "uint32_t",
                            "length": 28,
                            "display_format": "hex"
                        },
                        {
                            "signal_name": "bootloader_git_hash",
                            "data_type": "uint32_t",
                            "length": 28
                        },
                        {
                            "signal_name": "bootloadable",
                            "data_type": "bool"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                },
                {
                    "message_name": "rear_driveline_version",
                    "description": "Rear Driveline Version",
                    "signals": [
                        {
                            "signal_name": "git_hash",
                            "data_type": "uint32_t",
                            "length": 28,
                            "display_format": "hex"
                        },
                        {
                            "signal_name": "bootloader_git_hash",
                            "data_type": "uint32_t",
                            "length": 28
                        },
                        {
                            "signal_name": "bootloadable",
                            "data_type": "bool"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                },
                {
                    "message_name": "driveline_can_overflow",
                    "description": "count of dropped CAN packets due to queue overflow",
                    "signals": [
                        {
                            "signal_name": "rx_overflow",
                            "data_type": "uint32_t",
                            "description": "number of recieved packets dropped due to queue overflow"
                        },
                        {
                            "signal_name": "tx_overflow",
                            "data_type": "uint32_t",
                            "description": "number of packets to send dropped due to queue overflow"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                },
                {
                    "message_name": "driveline_can_tx_actions",
                    "description": "counts of software actions taken before CAN transmissions",
                    "signals": [
                        {
                            "signal_name": "enqueue_count",
                            "data_type": "uint32_t",
                            "description": "number of packets enqueued to be sent since startup"
                        },
                        {
                            "signal_name": "task_wake_count",
                            "data_type": "uint32_t",
                            "description": "number of times the tx task has be called since startup"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                },
                {
                    "message_name": "driveline_can_tx_messages",
                    "description": "counts of CAN packets transmitted",
                    "signals": [
                        {
                            "signal_name": "tx_sent",
                            "data_type": "uint32_t",
                            "description": "number of packets transmitted since startup"
                        },
                        {
                            "signal_name": "callbacks_sent",
                            "data_type": "uint32_t",
                            "description": "number of callback packets sent since startup"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                }
            ],
            "rx": [
                {
                    "message_name": "bl_front_driveline_start",
                    "callback": true
                },
                {
                    "message_name": "bl_rear_driveline_start",
                    "callback": true
                }
            ]
        }
    },
    "fault_library_enabled": false
}
