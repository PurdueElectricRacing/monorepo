{
    "node_name": "DRIVELINE",
    "busses": {
        "SCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "front_driveline_init",
                    "common_message": "node_init",
                    "priority": 3
                },
                {
                    "message_name": "rear_driveline_init",
                    "common_message": "node_init",
                    "priority": 3
                },
                {
                    "message_name": "front_shockpots",
                    "description": "Shockpot readings from front left and front right",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Length of front left shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Length of front right shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        }
                    ],
                    "priority": 5,
                    "period_ms": 10
                },
                {
                    "message_name": "rear_shockpots",
                    "description": "Shockpot readings from rear left and rear right",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Length of rear left shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Length of rear right shockpot",
                            "data_type": "uint16_t",
                            "unit": "mm",
                            "scale": 0.01
                        }
                    ],
                    "priority": 5,
                    "period_ms": 10
                },
                {
                    "message_name": "front_oil_temps",
                    "description": "oil temps from front",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Oil temp in front left gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Oil temp in front right gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        }
                    ],
                    "priority": 4,
                    "period_ms": 4000
                },
                {
                    "message_name": "rear_oil_temps",
                    "description": "oil temps from rear",
                    "signals": [
                        {
                            "signal_name": "left",
                            "description": "Oil temp in rear left gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        },
                        {
                            "signal_name": "right",
                            "description": "Oil temp in rear right gearbox",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.01
                        }
                    ],
                    "priority": 4,
                    "period_ms": 4000
                },
                {
                    "message_name": "front_driveline_version",
                    "common_message": "node_version"
                },
                {
                    "message_name": "rear_driveline_version",
                    "common_message": "node_version"
                },
                {
                    "message_name": "front_driveline_can_overflow",
                    "common_message": "can_overflow"
                },
                {
                    "message_name": "rear_driveline_can_overflow",
                    "common_message": "can_overflow"
                },
                {
                    "message_name": "driveline_diag_task",
                    "common_message": "diag_task"
                },
                {
                    "message_name": "driveline_diag_summary",
                    "common_message": "diag_summary"
                },
                {
                    "message_name": "driveline_diag_name",
                    "common_message": "diag_name"
                },
                {
                    "message_name": "driveline_broadcast_tec_error",
                    "common_message": "error_counter_val"
                }
            ],
            "rx": [
                {
                    "message_name": "bl_front_driveline_start",
                    "callback": true
                },
                {
                    "message_name": "bl_rear_driveline_start",
                    "callback": true
                }
            ]
        }
    },
    "fault_library_enabled": false
}
