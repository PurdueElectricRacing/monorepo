{
    "node_name": "PDU",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "pdu_init",
                    "description": "PDU hardware initialized",
                    "signals": [
                        {
                            "signal_name": "csr",
                            "description": "RCC CSR register",
                            "data_type": "uint32_t"
                        }
                    ],
                    "priority": 0
                },
                {
                    "message_name": "coolant_out",
                    "description": "outputs to coolant loops",
                    "signals": [
                        {
                            "signal_name": "is_powertrain_pumps_enabled",
                            "description": "Powertrain pumps enabled",
                            "data_type": "bool"
                        },
                        {
                            "signal_name": "is_hx_fan_enabled",
                            "description": "Heat exchanger fan enabled",
                            "data_type": "bool"
                        },
                        {
                            "signal_name": "is_batt_fans_enabled",
                            "description": "Battery fans enabled",
                            "data_type": "bool"
                        }
                    ],
                    "period_ms": 1000,
                    "priority": 4
                },
                {
                    "message_name": "pdu_version",
                    "description": "PDU version",
                    "signals": [
                        {
                            "signal_name": "git_hash",
                            "description": "int representation of git short hash",
                            "data_type": "uint32_t",
                            "display_format": "hex"
                        }
                    ],
                    "priority": 4,
                    "period_ms": 5000
                }
            ],
            "rx": [
                {
                    "message_name": "main_hb"
                },
                {
                    "message_name": "motor_temps"
                },
                {
                    "message_name": "igbt_temps"
                },
                {
                    "message_name": "pack_bms"
                }
            ]
        },
        "SCAN": {
            "peripheral": "FDCAN2",
            "tx": [],
            "rx": []
        }
    },
    "fault_library_enabled": true,
    "generate_fault_messages": false,
    "faults": [
