{
    "node_name": "MAIN_MODULE",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "main_init",
                    "common_message": "node_init"
                },
                {
                    "message_name": "main_hb",
                    "description": "Heart beat message for main module",
                    "signals": [
                        {
                            "signal_name": "car_state",
                            "description": "Main car state",
                            "data_type": "car_state_t"
                        }
                    ],
                    "period_ms": 500,
                    "priority": 2
                },
                {
                    "message_name": "motor_temps",
                    "description": "Temperature of motors",
                    "signals": [
                        {
                            "signal_name": "front_right",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "front_left",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "rear_left",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "rear_right",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        }
                    ],
                    "period_ms": 5000,
                    "priority": 4
                },
                {
                    "message_name": "igbt_temps",
                    "description": "Temperature of igbts",
                    "signals": [
                        {
                            "signal_name": "front_right",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "front_left",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "rear_left",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "rear_right",
                            "data_type": "int16_t",
                            "unit": "C",
                            "scale": 0.1
                        }
                    ],
                    "period_ms": 5000,
                    "priority": 4
                },
                {
                    "message_name": "motor_speeds",
                    "description": "Motor shaft speeds before gear reduction",
                    "signals": [
                        {
                            "signal_name": "front_right",
                            "data_type": "int16_t",
                            "unit": "rpm"
                        },
                        {
                            "signal_name": "front_left",
                            "data_type": "int16_t",
                            "unit": "rpm"
                        },
                        {
                            "signal_name": "rear_left",
                            "data_type": "int16_t",
                            "unit": "rpm"
                        },
                        {
                            "signal_name": "rear_right",
                            "data_type": "int16_t",
                            "unit": "rpm"
                        }
                    ],
                    "period_ms": 20,
                    "priority": 5
                },
                {
                    "message_name": "vbatt_vmc",
                    "description": "VBATT and VMC voltages sensed by main module",
                    "signals": [
                        {
                            "signal_name": "vbatt",
                            "description": "Accumulator-side HV voltage",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.1
                        },
                        {
                            "signal_name": "vmc",
                            "description": "Motor-controller-side HV voltage",
                            "data_type": "uint16_t",
                            "unit": "V",
                            "scale": 0.1
                        }
                    ],
                    "period_ms": 20,
                    "priority": 5
                },
                {
                    "message_name": "main_version",
                    "common_message": "node_version"
                },
                {
                    "message_name": "inva_diagnostics",
                    "common_message": "amk_diagnostics"
                },
                {
                    "message_name": "invb_diagnostics",
                    "common_message": "amk_diagnostics"
                },
                {
                    "message_name": "invc_diagnostics",
                    "common_message": "amk_diagnostics"
                },
                {
                    "message_name": "invd_diagnostics",
                    "common_message": "amk_diagnostics"
                },
                {
                    "message_name": "main_can_overflow",
                    "common_message": "can_overflow"
                },
                {
                    "message_name": "main_can_tx_actions",
                    "common_message": "can_tx_actions"
                },
                {
                    "message_name": "main_can_tx_messages",
                    "common_message": "can_tx_messages"
                },
                {
                    "message_name": "main_module_diag_task",
                    "common_message": "diag_task"
                },
                {
                    "message_name": "main_module_diag_summary",
                    "common_message": "diag_summary"
                },
                {
                    "message_name": "main_module_diag_name",
                    "common_message": "diag_name"
                }
            ],
            "rx": [
                {
                    "message_name": "pedals"
                },
                {
                    "message_name": "start_button",
                    "callback": false
                },
                {
                    "message_name": "vcu_settings"
                },
                {
                    "message_name": "vcu_torque_request"
                },
                {
                    "message_name": "bms_voltages"
                },
                {
                    "message_name": "bl_main_module_start",
                    "callback": true
                }
            ]
        },
        "MCAN": {
            "peripheral": "FDCAN2",
