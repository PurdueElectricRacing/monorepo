                    "id_override": "0x113"
                },
                {
                    "message_name": "INVD_SET",
                    "common_message": "amk_set",
                    "id_override": "0x114"
                }
            ],
            "rx": [
                {
                    "message_name": "INVA_CRIT"
                },
                {
                    "message_name": "INVA_INFO"
                },
                {
                    "message_name": "INVA_ERR_1"
