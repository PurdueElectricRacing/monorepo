{
    "messages": [
        {
            "name": "diag_task",
            "description": "RTOS Task profiling status",
            "priority": 3,
            "signals": [
                {
                    "signal_name": "task_id",
                    "data_type": "uint32_t"
                },
                {
                    "signal_name": "stack_hwm",
                    "data_type": "uint16_t",
                    "description": "Min free stack bytes"
                },
                {
                    "signal_name": "cpu_percent",
                    "data_type": "uint8_t",
                    "description": "CPU Usage Percentage, 255 is invalid"
                },
                {
                    "signal_name": "state",
                    "data_type": "diagnostics_task_state_t",
                    "description": "FreeRTOS task state"
                }
            ]
        },
        {
            "name": "diag_summary",
            "description": "Overall CPU and task status",
            "priority": 3,
            "period_ms": 1000,
            "signals": [
                {
                    "signal_name": "sample_count",
                    "data_type": "uint32_t"
                },
                {
                    "signal_name": "task_count",
                    "data_type": "uint16_t"
                },
                {
                    "signal_name": "cpu_percent",
                    "data_type": "uint8_t",
                    "description": "Whole number CPU pct. util., 255 is invalid"
                },
                {
                    "signal_name": "capacity_exceeded",
                    "data_type": "bool",
                    "description": "True if task capacity exceeded"
                }
            ]
        },
        {
            "name": "diag_name",
            "description": "Task name character",
            "priority": 3,
            "signals": [
                {
                    "signal_name": "task_id",
                    "data_type": "uint32_t"
                },
                {
                    "signal_name": "char_index",
                    "data_type": "uint8_t"
                },
                {
                    "signal_name": "character",
                    "data_type": "uint8_t"
                }
            ]
        },
        {
            "name": "can_overflow",
            "description": "count of dropped CAN packets due to queue overflow",
            "priority": 4,
            "period_ms": 5000,
            "signals": [
                {
                    "signal_name": "rx_overflow",
                    "data_type": "uint32_t",
                    "description": "number of received packets dropped due to queue overflow"
                },
                {
                    "signal_name": "tx_overflow",
                    "data_type": "uint32_t",
                    "description": "number of packets to send dropped due to queue overflow"
                }
            ]
        },
        {
            "name": "can_tx_actions",
            "description": "counts of software actions taken before CAN transmissions",
            "priority": 4,
            "period_ms": 5000,
            "signals": [
                {
                    "signal_name": "enqueue_count",
                    "data_type": "uint32_t",
                    "description": "number of packets enqueued to be sent since startup"
                },
                {
                    "signal_name": "task_wake_count",
                    "data_type": "uint32_t",
                    "description": "number of times the tx task has been called since startup"
                }
            ]
        },
        {
            "name": "can_tx_messages",
            "description": "counts of CAN packets transmitted",
            "priority": 4,
            "period_ms": 5000,
            "signals": [
                {
                    "signal_name": "tx_sent",
                    "data_type": "uint32_t",
                    "description": "number of packets transmitted since startup"
                },
                {
                    "signal_name": "tx_callbacks",
                    "data_type": "uint32_t",
                    "description": "number of CAN TX completion ISR callbacks since startup"
                }
            ]
        },
        {
            "name": "node_version",
            "description": "Node firmware and bootloader version",
            "priority": 4,
            "period_ms": 5000,
            "signals": [
                {
                    "signal_name": "git_hash",
                    "data_type": "uint32_t",
                    "length": 28,
                    "display_format": "hex"
                },
                {
                    "signal_name": "bootloader_git_hash",
                    "data_type": "uint32_t",
                    "length": 28
                },
                {
                    "signal_name": "bootloadable",
                    "data_type": "bool"
                }
            ]
        },
        {
            "name": "node_init",
            "description": "Node hardware initialized",
            "priority": 0,
            "signals": [
                {
                    "signal_name": "csr",
                    "description": "RCC CSR register",
                    "data_type": "uint32_t"
                }
            ]
        }
    ]
}
