{
    "node_name": "E_METER",
    "bus_name": "VCAN",
    "tx": [
        {
            "message_name": "E_METER_MEASUREMENT",
            "description": "Contains current (A) and voltage (V) as measured by the E Meter",
            "byte_order": "little_endian",
            "signals": [
                {
                    "signal_name": "current",
                    "description": "Current (A) as measured by the E Meter",
                    "data_type": "float",
                    "unit": "A"
                },
                {
                    "signal_name": "voltage",
                    "description": "Voltage (V) as measured by the E Meter",
                    "data_type": "float",
                    "unit": "V"
                }
            ],
            "period_ms": 20,
            "id_override": "0x10d",
            "priority": 5
        },
        {
            "message_name": "E_METER_STATUS",
            "description": "Contains violation, logging, and Energy (Whr) status signals.",
            "byte_order": "little_endian",
            "signals": [
                {
                    "signal_name": "violation",
                    "description": "True if we are in violation of power, voltage, or temperature regulations.",
                    "data_type": "bool"
                },
                {
                    "signal_name": "logging",
                    "description": "True if the E-Meter is currently logging. (TS Voltage >60V)",
                    "data_type": "bool"
                },
                {
                    "signal_name": "fault_active",
                    "description": "True if the E-Meter is currently faulted.",
                    "data_type": "bool"
                },
                {
                    "signal_name": "fault_prev_active",
                    "description": "True if the E-Meter was previously faulted.",
                    "data_type": "bool"
                },
                {
                    "signal_name": "reserved_bool0",
                    "data_type": "bool"
                },
                {
                    "signal_name": "reserved_bool1",
                    "data_type": "bool"
                },
                {
                    "signal_name": "reserved_bool2",
                    "data_type": "bool"
                },
                {
                    "signal_name": "reserved_bool3",
                    "data_type": "bool"
                },
                {
                    "signal_name": "energy",
                    "description": "Energy as seen by the E-Meter in Watt hours",
                    "data_type": "float",
                    "unit": "Whr"
                },
                {
                    "signal_name": "reserved1",
                    "data_type": "uint8_t"
                },
                {
                    "signal_name": "reserved2",
                    "data_type": "uint8_t"
                },
                {
                    "signal_name": "reserved3",
                    "data_type": "uint8_t"
                }
            ],
            "period_ms": 100,
            "id_override": "0x40d",
            "priority": 5
        },
        {
            "message_name": "E_METER_TEMPERATURE",
            "description": "Reports sensor count, minimum and maximum temperatures, and a group of temperature sensors as selected by multiplexor.",
            "byte_order": "little_endian",
            "signals": [
                {
                    "signal_name": "multiplexor",
                    "description": "Multiplexor selection",
                    "data_type": "uint8_t",
                    "length": 3
                },
                {
                    "signal_name": "num_sensors",
                    "description": "The number of temperature sensors",
                    "data_type": "uint8_t",
                    "length": 5
                },
                {
                    "signal_name": "min_temperature",
                    "description": "Minimum temperature.",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                },
                {
                    "signal_name": "max_temperature",
                    "description": "Maximum temperature.",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                },
                {
                    "signal_name": "temperature_slot_0",
                    "description": "Multiplexor * 5",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                },
                {
                    "signal_name": "temperature_slot_1",
                    "description": "Multiplexor * 5 + 1",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                },
                {
                    "signal_name": "temperature_slot_2",
                    "description": "Multiplexor * 5 + 2",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                },
                {
                    "signal_name": "temperature_slot_3",
                    "description": "Multiplexor * 5 + 3",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                },
                {
                    "signal_name": "temperature_slot_4",
                    "description": "Multiplexor * 5 + 4",
                    "data_type": "uint8_t",
                    "unit": "C",
                    "scale": 0.5
                }
            ],
            "period_ms": 250,
            "id_override": "0x60d",
            "priority": 5
        }
    ],
    "rx": []
}