{
    "node_name": "ELCON_CHARGER",
    "bus_name": "CCAN",
    "tx": [
        {
            "message_name": "elcon_status",
            "description": "Status message from Elcon Charger to A_BOX (Message2)",
            "byte_order": "big_endian",
            "signals": [
                {
                    "signal_name": "charge_voltage",
                    "data_type": "uint16_t",
                    "unit": "V",
                    "scale": 0.1
                },
                {
                    "signal_name": "charge_current",
                    "data_type": "uint16_t",
                    "unit": "A",
                    "scale": 0.1
                },
                {
                    "signal_name": "is_hardware_fail",
                    "description": "Hardware failure",
                    "data_type": "bool"
                },
                {
                    "signal_name": "is_over_temperature",
                    "description": "Charger overtemp protection active",
                    "data_type": "bool"
                },
                {
                    "signal_name": "is_invalid_input_voltage",
                    "description": "Invalid input voltage",
                    "data_type": "bool"
                },
                {
                    "signal_name": "is_startup_fail",
                    "description": "Charger stays off to prevent reverse polarity",
                    "data_type": "bool"
                },
                {
                    "signal_name": "is_comms_timeout",
                    "description": "5s elapsed since last rx of 0x1806E5F4",
                    "data_type": "bool"
                }
            ],
            "id_override": "0x18FF50E5",
            "period_ms": 1000,
            "priority": 3
        }
    ],
    "rx": [
        {
            "message_name": "elcon_command"
        }
    ]
}
