{% if angle %}
// ============================================================================
// Angle operations
// ============================================================================

{% for unit in angle.units %}
{% set radians = 'a.value' if unit.scale == 1 else 'a.value * ' ~ (unit.scale|format_float) %}
[[nodiscard, gnu::always_inline]] static inline
float dearunits_sin_{{ unit.name }}({{ unit.type_name }} a) {
    return __builtin_sinf({{ radians }});
}

[[nodiscard, gnu::always_inline]] static inline
float dearunits_cos_{{ unit.name }}({{ unit.type_name }} a) {
    return __builtin_cosf({{ radians }});
}

[[nodiscard, gnu::always_inline]] static inline
float dearunits_tan_{{ unit.name }}({{ unit.type_name }} a) {
    return __builtin_tanf({{ radians }});
}

// Wraps to [-half turn, half turn)
[[nodiscard, gnu::always_inline]] static inline
{{ unit.type_name }} dearunits_wrap_angle_{{ unit.name }}({{ unit.type_name }} a) {
    return ({{ unit.type_name }}){ .value = __builtin_fmodf(__builtin_fmodf(a.value + {{ unit.half_turn|format_float }}, {{ unit.full_turn|format_float }}) + {{ unit.full_turn|format_float }}, {{ unit.full_turn|format_float }}) - {{ unit.half_turn|format_float }} };
}

// Wraps to [0, full turn)
[[nodiscard, gnu::always_inline]] static inline
{{ unit.type_name }} dearunits_wrap_angle_positive_{{ unit.name }}({{ unit.type_name }} a) {
    return ({{ unit.type_name }}){ .value = __builtin_fmodf(__builtin_fmodf(a.value, {{ unit.full_turn|format_float }}) + {{ unit.full_turn|format_float }}, {{ unit.full_turn|format_float }}) };
}

// Shortest signed difference a - b
[[nodiscard, gnu::always_inline]] static inline
{{ unit.type_name }} dearunits_angle_diff_{{ unit.name }}({{ unit.type_name }} a, {{ unit.type_name }} b) {
    return dearunits_wrap_angle_{{ unit.name }}(({{ unit.type_name }}){ .value = a.value - b.value });
}

