// ============================================================================
// Multiply / divide
// ============================================================================

// Base-unit pairs resolve through explicit relations, then dimensional analysis.
// Every unit type also takes a float on the right (DEARUNITS_MULTIPLY(x, 2.0f));
// float * unit and float / unit work where the result is a unit type (1 / time = frequency).
//
// Every inner _Generic is type-checked even when its branch isn't selected, so
// each needs a default; an unsupported operand pair selects this non-function,
// and calling it is a compile error.
extern const int dearunits_error_unsupported_operands_use_base_units_or_float;

{% for definition in binary_ops.definitions %}
{{ definition.macro }}({{ definition.args|join(', ') }})
{% endfor %}

{% for macro_name, dispatch in [('MULTIPLY', binary_ops.multiply), ('DIVIDE', binary_ops.divide)] %}
#define DEARUNITS_{{ macro_name }}(a, b) _Generic((a), \
{% for lhs in dispatch %}
    {{ lhs.lhs_type }}: _Generic((b), \
{% for entry in lhs.entries %}
        {{ entry.rhs_type }}: {{ entry.function }}, \
{% endfor %}
        default: dearunits_error_unsupported_operands_use_base_units_or_float \
    ), \
{% endfor %}
    default: dearunits_error_unsupported_operands_use_base_units_or_float \
)(a, b)

{% endfor %}
