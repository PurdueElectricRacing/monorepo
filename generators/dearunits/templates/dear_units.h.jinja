{{ angle.base_type }} dearunits_asin(float x) {
    return ({{ angle.base_type }}){ .value = __builtin_asinf(x) };
}

[[nodiscard, gnu::always_inline]] static inline
{{ angle.base_type }} dearunits_acos(float x) {
