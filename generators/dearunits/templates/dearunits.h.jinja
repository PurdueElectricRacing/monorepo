#ifndef DEARUNITS_H
#define DEARUNITS_H

#include "../dearunits_priv.h"

#define DU_FUNC_MODIFIERS [[nodiscard, gnu::always_inline]] static inline

/**
 * @file dearunits.h
 * @brief Auto-generated unit types and conversion functions.
 * @note This file is auto-generated by DearUnits; do not modify manually.
 *
 * @author Danny Proano (dproano@purdue.edu)
 */

// ============================================================================
// Unit types
// ============================================================================

{% for group in groups %}
// {{ group.name }}
typedef struct { float value; } {{ group.base.type_name }};
{% for unit in group.non_base %}
typedef struct { float value; } {{ unit.type_name }};
{% endfor %}

{% endfor %}
// ============================================================================
// Conversions: to/from each group's base unit
// ============================================================================

{% for group in groups if group.has_conversions %}
// {{ group.name }}
{% for unit in group.non_base %}
DU_FUNC_MODIFIERS
{{ group.base.type_name }} {{ group.base.name }}_from_{{ unit.name }}({{ unit.type_name }} x) {
    return ({{ group.base.type_name }}){ .value = x.value * {{ unit.scale|format_float }}{% if unit.offset %} + {{ unit.offset|format_float }}{% endif %} };
}

DU_FUNC_MODIFIERS
{{ unit.type_name }} {{ unit.name }}_from_{{ group.base.name }}({{ group.base.type_name }} x) {
    return ({{ unit.type_name }}){ .value = {% if unit.offset %}(x.value - {{ unit.offset|format_float }}){% else %}x.value{% endif %} / {{ unit.scale|format_float }} };
}

{% endfor %}
#define {{ group.dispatch_name }}(x) _Generic((x), \
{% for unit in group.non_base %}
    {{ unit.type_name }}: {{ group.base.name }}_from_{{ unit.name }}{% if not loop.last %},{% endif %} \
{% endfor %}
)(x)

{% endfor %}
// ============================================================================
// Compound constructors
// ============================================================================

{% for group in groups if group.arithmetic %}
DU_FUNC_MODIFIERS
{{ group.arithmetic.result_type }} {{ group.arithmetic.compound_name }}_from({% for p in group.arithmetic.params %}{{ p.type_name }} {{ p.group_name }}{% if not loop.last %}, {% endif %}{% endfor %}) {
{% if group.arithmetic.denominator_terms %}
    return ({{ group.arithmetic.result_type }}){ .value = {{ group.arithmetic.numerator_terms|join(' * ') if group.arithmetic.numerator_terms else '1.0f' }} / ({{ group.arithmetic.denominator_terms|join(' * ') }}) };
{% else %}
    return ({{ group.arithmetic.result_type }}){ .value = {{ group.arithmetic.numerator_terms|join(' * ') }} };
{% endif %}
}

{% endfor %}

{% for unit in base_types %}
DU_DEFINE_UNIT_OPERATIONS({{ unit.name }})
{% endfor %}

{% macro dispatch_macros(ops, types) %}
{% for macro_name, function, args in ops %}
#define DU_{{ macro_name }}({{ args }}) _Generic(({{ args.split(', ')[0] }}), \
{% for unit in types %}
    {{ unit.type_name }}: dearunits_{{ function }}_{{ unit.name }}{% if not loop.last %},{% endif %} \
{% endfor %}
)({{ args }})

{% endfor %}
{% endmacro %}
{{ dispatch_macros([
    ('ADD', 'add', 'a, b'),
    ('SUBTRACT', 'subtract', 'a, b'),
    ('NEGATE', 'negate', 'a'),
    ('ABS', 'abs', 'a'),
    ('MIN', 'min', 'a, b'),
    ('MAX', 'max', 'a, b'),
    ('CLAMP', 'clamp', 'x, lo, hi'),
    ('ABS_DIFF', 'abs_diff', 'a, b'),
    ('NEARLY_EQUAL', 'nearly_equal', 'a, b, tol'),
    ('LT', 'lt', 'a, b'),
    ('GT', 'gt', 'a, b'),
    ('LE', 'le', 'a, b'),
    ('GE', 'ge', 'a, b'),
], base_types) }}
// ============================================================================
// Multiply / divide
// ============================================================================

extern const int dearunits_error_unsupported_operands_use_base_units_or_float;

{% for definition in binary_ops.definitions %}
{{ definition.macro }}({{ definition.args|join(', ') }})
{% endfor %}

{% for macro_name, dispatch in [('MULTIPLY', binary_ops.multiply), ('DIVIDE', binary_ops.divide)] %}
#define DU_{{ macro_name }}(a, b) _Generic((a), \
{% for lhs in dispatch %}
    {{ lhs.lhs_type }}: _Generic((b), \
{% for entry in lhs.entries %}
        {{ entry.rhs_type }}: {{ entry.function }}, \
{% endfor %}
        default: dearunits_error_unsupported_operands_use_base_units_or_float \
    ), \
{% endfor %}
    default: dearunits_error_unsupported_operands_use_base_units_or_float \
)(a, b)

{% endfor %}
{% if binary_ops.squares %}
// ============================================================================
// Square / square root
// ============================================================================

{% for sq in binary_ops.squares %}
DU_FUNC_MODIFIERS
{{ sq.result_type }} dearunits_square_{{ sq.operand_name }}({{ sq.operand_type }} a) {
    return ({{ sq.result_type }}){ .value = a.value * a.value };
}

DU_FUNC_MODIFIERS
{{ sq.operand_type }} dearunits_sqrt_{{ sq.result_name }}({{ sq.result_type }} a) {
    return ({{ sq.operand_type }}){ .value = __builtin_sqrtf(a.value) };
}

{% endfor %}
#define DU_SQUARE(a) _Generic((a), \
{% for sq in binary_ops.squares %}
    {{ sq.operand_type }}: dearunits_square_{{ sq.operand_name }}{% if not loop.last %},{% endif %} \
{% endfor %}
)(a)

#define DU_SQRT(a) _Generic((a), \
{% for sq in binary_ops.squares %}
    {{ sq.result_type }}: dearunits_sqrt_{{ sq.result_name }}{% if not loop.last %},{% endif %} \
{% endfor %}
)(a)

{% endif %}
#endif // DEARUNITS_H
