// Peripheral initialization (board clocks and GPIO must be configured first)
static inline void CAN_init_peripherals(void) {
{% for periph in ctx.peripheral_entries %}
    PHAL_FDCAN_init({{ periph.name }}, {{ periph.baud_rate_constant }});
{% endfor %}
}

// Filter configuration
{% for peripheral in ctx.peripheral_entries if peripheral.name in ctx.filters %}
{% set filters = ctx.filters[peripheral.name] %}
// CAN filter setup for {{ peripheral.name }}
static inline void {{ peripheral.name }}_init_filters() {
    {% if filters.accept_all %}
    // Accept all messages - filters configured in PHAL_FDCAN_init() by default
    (void)0;
    {% elif filters.std_ids or filters.ext_ids %}
    {% if filters.std_ids %}
    static const uint32_t sid_list[] = {
        {% for msg in filters.std_ids %}
        {{ msg.macro_name }}_MSG_ID{{ "," if not loop.last }}
        {% endfor %}
    };
    {% endif %}

    {% if filters.ext_ids %}
    static const uint32_t xid_list[] = {
        {% for msg in filters.ext_ids %}
        {{ msg.macro_name }}_MSG_ID{{ "," if not loop.last }}
        {% endfor %}
    };
    {% endif %}

    PHAL_FDCAN_setFilters(
        {{ peripheral.name }},
        {% if filters.std_ids %}
        sid_list, {{ filters.std_ids|length }},
        {% else %}
        NULL, 0,
        {% endif %}
        {% if filters.ext_ids %}xid_list,
        {{ filters.ext_ids|length }}
        {% else %}
        NULL, 0
        {% endif %}
    );
    {% else %}
    // No filters configured
    (void)0;
    {% endif %}
}
{% endfor %}
