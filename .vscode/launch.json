            "debuggerArgs": [
                "-d",
                "${workspaceRoot}/firmware/source/main_module"
            ],
            "preLaunchTask": "build firmware",
            "runToEntryPoint": "main",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 5
            }
