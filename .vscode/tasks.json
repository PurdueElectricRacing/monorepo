{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "type": "shell",
            "command": "clear && python3 build_all.py",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build firmware",
            "type": "shell",
            "command": "clear && python3 firmware/build_firmware.py",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "check firmware",
            "type": "shell",
            "command": "clear && python3 firmware/check_firmware.py",
            "group": {
                "kind": "test"
            }
        },
        {
            "label": "build daqapp",
            "type": "shell",
            "command": "clear && cargo build --manifest-path daqapp/Cargo.toml",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "generate can library",
            "type": "shell",
            "command": "python3 ./firmware/generators/generate.py",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "run unit tests",
            "type": "shell",
            "command": "clear && python3 tests/build_tests.py",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "run doxygen",
            "type": "shell",
            "command": "doxygen ./docs/Doxyfile",
            "problemMatcher": []
        }
    ]
}
