        },
        {
            "label": "fil network run",
            "type": "shell",
            "command": "make -C tests/external/fil build BUILD_ARGS=\"--target fil\" && tests/external/fil/build/fil run tests/fil/network.json --duration 1s --strict-mmio",
            "group": {
                "kind": "test"
            }
        },
        {
            "label": "fil monitor (telnet)",
            "type": "shell",
            "command": "nc 127.0.0.1 4444",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}
