{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "type": "shell",
            "command": "clear && python3 build_all.py",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build firmware",
            "type": "shell",
            "command": "clear && python3 firmware/build_firmware.py",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "check firmware",
            "type": "shell",
            "command": "clear && python3 firmware/check_firmware.py",
            "group": {
                "kind": "test"
            }
        },
        {
            "label": "build daqapp",
            "type": "shell",
            "command": "clear && cargo build --manifest-path daq/daqapp/Cargo.toml --locked",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "build daq workspace",
            "type": "shell",
            "command": "clear && cargo build --manifest-path daq/Cargo.toml --workspace --all-targets --locked",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "run generators",
            "type": "shell",
            "command": "python3 ./generators/generate.py",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "run tests",
            "type": "shell",
            "command": "clear && python3 tests/run_tests.py",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "run doxygen",
            "type": "shell",
            "command": "doxygen ./docs/Doxyfile",
            "problemMatcher": []
        },
        {
            "label": "fil build",
            "type": "shell",
            "command": "make -C tests/external/fil build BUILD_ARGS=\"--target fil\"",
            "group": {
                "kind": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "fil debug (a_box)",
            "type": "shell",
            "command": "make -C tests/external/fil build BUILD_ARGS=\"--target fil\" && echo fil debug: starting gdb server && tests/external/fil/build/fil debug tests/fil/boards/a_box.json --gdb-port 3333 --once",
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "fil",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "fil debug: starting gdb server",
                    "endsPattern": "GDB on "
                }
            }
        },
        {
            "label": "fil debug (dashboard)",
            "type": "shell",
            "command": "make -C tests/external/fil build BUILD_ARGS=\"--target fil\" && echo fil debug: starting gdb server && tests/external/fil/build/fil debug tests/fil/boards/dashboard.json --gdb-port 3333 --once",
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "fil",
                "pattern": {
                    "regexp": "^$"
                },
