# Keep these empty directories
!firmware/build
firmware/build/**
!firmware/output
firmware/output/**

# Ignore doxygen output
/docs/doxygen

# Allow per-user settings and debug states
.cache/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
/.vscode/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# MacOS
*.DS_Store

# CANpiler Autogenerated files
firmware/can_library/generated/
/dbc/

# cargo build artifacts
target/

# daqapp runtime files
/daq/daqapp/settings.json
/daq/daqapp/logs/
/settings.json
/logs/

# Dont include venv and local dependencies
venv
.venv
.envrc
.direnv
