# Keep these empty directories
!firmware/build
firmware/build/**
!firmware/output
firmware/output/**

# Ignore doxygen output
/docs/doxygen

# Allow per-user settings and debug states
.cache/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
/.vscode/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# MacOS
*.DS_Store

# CANpiler Autogenerated files
firmware/can_library/generated/
firmware/can_library/dbc/

# cargo build artifacts
daqapp/target/
target/

# daqapp runtime files
daqapp/settings.json
daqapp/logs
/settings.json
/logs/

# Dont include venv and local dependencies
venv
.venv
.envrc
.direnv