# Firmware build intermediates
firmware/build/

# Final build outputs
/artifacts/

# Ignore doxygen output
/docs/doxygen
/docs/can_graphs/
/docs/unit_graphs/*

# Allow per-user settings and debug states
.cache/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
/.vscode/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# MacOS
*.DS_Store

# CANpiler Autogenerated files
firmware/can_library/generated/

# DearUnits Autogenerated files
firmware/common/dearunits/generated/

# FIL Autogenerated files
tests/fil/stimuli/

# cargo build artifacts
target/

# daqapp runtime files
/daq/settings.json
/daq/daqapp/settings.json
/daq/daqapp/logs/
/settings.json
/logs/

# Dont include venv and local dependencies
venv
.venv
.envrc
.direnv

# plot factory
/plot_factory/data/**
!/plot_factory/data/README.md
/plot_factory/output/

# Yoctocoupler build checkouts (KAS layers, downloads, sstate, build dirs)
/torque_vector/yoctocoupler/build/
/torque_vector/yoctocoupler/downloads/
/torque_vector/yoctocoupler/sstate-cache/
/torque_vector/yoctocoupler/poky/
/torque_vector/yoctocoupler/meta-raspberrypi/
/torque_vector/yoctocoupler/meta-openembedded/

# daqcloud db
daq/daqcloud/daqcloud.db
daq/daqcloud/daqcloud.db-shm
daq/daqcloud/daqcloud.db-wal
daq/daqcloud/migrations/.diesel_lock
