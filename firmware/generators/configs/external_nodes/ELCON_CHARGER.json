{
    "node_name": "ELCON_CHARGER",
    "bus_name": "CCAN",
    "tx": [
        {
            "message_name": "elcon_status",
            "description": "Status message from Elcon Charger to A_BOX (Message2)",
            "byte_order": "big_endian",
            "signals": [
                {
                    "signal_name": "charge_voltage",
                    "unit": "V",
                    "scale": 0.1,
                    "type": "uint16_t"
                },
                {
                    "signal_name": "charge_current",
                    "unit": "A",
                    "scale": 0.1,
                    "type": "uint16_t"
                },
                {
                    "signal_name": "hw_fail",
                    "description": "Hardware failure",
                    "type": "bool"
                },
                {
                    "signal_name": "temp_fail",
                    "description": "Temperature failure",
                    "type": "bool"
                },
                {
                    "signal_name": "input_v_fail",
                    "description": "Input voltage failure",
                    "type": "bool"
                },
                {
                    "signal_name": "startup_fail",
                    "description": "Startup voltage detection failure",
                    "type": "bool"
                },
                {
                    "signal_name": "communication_fail",
                    "description": " 5s timeout from communication failure",
                    "type": "bool"
                }
            ],
            "id_override": "0x18FF50E5",
            "period_ms": 1000,
            "priority": 3
        }
    ],
    "rx": [
        {
            "message_name": "elcon_command"
        }
    ]
}
