{
    "node_name": "BL_TORQUE_VECTOR",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "message_name": "bl_torque_vector_resp",
                    "description": "CAN bootloader response for torque vector",
                    "signals": [
                        {"signal_name": "status", "data_type": "uint8_t"},
                        {"signal_name": "detail", "data_type": "uint32_t"}
                    ],
                    "id_override": "0x188",
                    "priority": 0
                }
            ],
            "rx": [
                {"message_name": "bl_torque_vector_cmd"},
                {"message_name": "bl_torque_vector_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
