            "time_to_unlatch": 10000,
            "lcd_message": "Front Driveline Rail Down"
        },
        {
            "fault_name": "rear_driveline_rail",
            "max": 1,
            "min": 0,
            "priority": "warning",
            "time_to_latch": 100,
            "time_to_unlatch": 10000,
            "lcd_message": "Rear Driveline Rail Down"
        },
        {
            "fault_name": "bullet_rail",
            "max": 1,
            "min": 0,
            "priority": "warning",
            "time_to_latch": 100,
            "time_to_unlatch": 10000,
            "lcd_message": "Bullet Rail Down"
        },
        {
            "fault_name": "lv_critical_low",
