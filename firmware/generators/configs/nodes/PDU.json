{
    "node_name": "PDU",
    "busses": {
        "VCAN": {
            "peripheral": "CAN1",
            "tx": [
                {
                    "msg_name": "pdu_init",
                    "msg_desc": "PDU hardware initialized",
                    "signals": [
                        {
                            "sig_name": "csr",
                            "sig_desc": "RCC CSR register",
                            "type": "uint32_t"
                        }
                    ],
                    "msg_priority": 0
                },
                {
                    "msg_name": "v_rails",
                    "msg_desc": "PDU voltage rail readings",
                    "signals": [
                        {
                            "sig_name": "in_24v",
                            "sig_desc": "Unregulated 24V input",
                            "type": "uint16_t",
                            "unit": "mV"
                        },
                        {
                            "sig_name": "out_5v",
                            "sig_desc": "5v rail output voltage",
                            "type": "uint16_t",
                            "unit": "mV"
                        },
                        {
                            "sig_name": "out_3v3",
                            "sig_desc": "3v3 rail output voltage",
                            "type": "uint16_t",
                            "unit": "mV"
                        },
                        {
                            "sig_name": "amk_24v",
                            "type": "uint16_t",
                            "unit": "mV"
                        }
                    ],
                    "msg_period": 100,
                    "msg_priority": 5
                },
                {
                    "msg_name": "rail_currents",
                    "msg_desc": "PDU rail currents",
                    "signals": [
                        {
                            "sig_name": "i_24v",
                            "sig_desc": "Unregulated 24V rail current",
                            "type": "uint16_t",
                            "unit": "mA"
                        },
                        {
                            "sig_name": "i_5v",
                            "sig_desc": "5v rail current",
                            "type": "uint16_t",
                            "unit": "mA"
                        }
                    ],
                    "msg_period": 100,
                    "msg_priority": 5
                },
                {
                    "msg_name": "pump_and_fan_current",
                    "msg_desc": "PDU pump and fan currents",
                    "signals": [
                        {
                            "sig_name": "i_pump1",
                            "type": "uint16_t",
                            "unit": "mA"
                        },
                        {
                            "sig_name": "i_pump2",
                            "type": "uint16_t",
                            "unit": "mA"
                        },
                        {
                            "sig_name": "i_fan1",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        },
                        {
                            "sig_name": "i_fan2",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        }
                    ],
                    "msg_period": 100,
                    "msg_priority": 5
                },
                {
                    "msg_name": "fan_current2",
                    "msg_desc": "more fan currents",
                    "signals": [
                        {
                            "sig_name": "i_fan3",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        },
                        {
                            "sig_name": "i_fan4",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        }
                    ],
                    "msg_period": 100,
                    "msg_priority": 5
                },
                {
                    "msg_name": "other_currents",
                    "msg_desc": "Other PDU currents",
                    "signals": [
                        {
                            "sig_name": "i_sdc",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        },
                        {
                            "sig_name": "i_aux",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        },
                        {
                            "sig_name": "i_dash",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        },
                        {
                            "sig_name": "i_abox",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        },
                        {
                            "sig_name": "i_main",
                            "type": "uint16_t",
                            "unit": "mA",
                            "length": 12
                        }
                    ],
                    "msg_period": 100,
                    "msg_priority": 5
                },
                {
                    "msg_name": "coolant_out",
                    "msg_desc": "outputs to coolant loops",
                    "signals": [
                        {
                            "sig_name": "is_powertrain_pumps_enabled",
                            "sig_desc": "Powertrain pumps enabled",
                            "type": "bool"
                        },
                        {
                            "sig_name": "is_hx_fan_enabled",
                            "sig_desc": "Heat exchanger fan enabled",
                            "type": "bool"
                        },
                        {
                            "sig_name": "is_batt_fans_enabled",
                            "sig_desc": "Battery fans enabled",
                            "type": "bool"
                        }
                    ],
                    "msg_period": 1000,
                    "msg_priority": 4
                },
                {
                    "msg_name": "pdu_temps",
                    "msg_desc": "PDU board temperatures",
                    "signals": [
                        {
                            "sig_name": "internal_therm",
                            "sig_desc": "Temperature from internal thermistor",
                            "type": "uint16_t",
                            "unit": "C"
                        }
                    ],
                    "msg_period": 100,
                    "msg_priority": 5
                },
                {
                    "msg_name": "pdu_can_stats",
                    "msg_desc": "CAN diagnostics",
                    "signals": [
                        {
                            "sig_name": "can_tx_overflow",
                            "type": "uint8_t",
                            "sig_desc": "CAN Tx queue overflow count"
                        },
                        {
                            "sig_name": "can_tx_fail",
                            "type": "uint8_t",
                            "sig_desc": "CAN Tx fail count (due to timeout in mailbox)"
                        },
                        {
                            "sig_name": "can_rx_overflow",
                            "type": "uint8_t",
                            "sig_desc": "CAN Rx queue overflow count"
                        },
                        {
                            "sig_name": "can_rx_overrun",
                            "type": "uint8_t",
                            "sig_desc": "CAN Rx FIFO overrun count"
                        }
                    ],
                    "msg_period": 1000,
                    "msg_priority": 4
                },
                {
                    "msg_name": "pdu_version",
                    "msg_desc": "PDU version",
                    "signals": [
                        {
                            "sig_name": "git_hash",
                            "type": "uint32_t",
                            "sig_desc": "int representation of git short hash"
                        }
                    ],
                    "msg_priority": 5,
                    "msg_period": 5000
                }
            ],
            "rx": [
                {
                    "msg_name": "main_hb"
                },
                {
                    "msg_name": "motor_temps"
                },
                {
                    "msg_name": "igbt_temps"
                },
                {
                    "msg_name": "pack_stats"
                }
            ]
        }
    },
    "fault_library_enabled": true,
    "generate_fault_messages": false,
    "faults": [
        {
            "fault_name": "dash_rail",
            "max": 1,
            "min": 0,
            "priority": "error",
            "time_to_latch": 100,
            "time_to_unlatch": 10000,
            "lcd_message": "Dash Rail Down"
        },
        {
            "fault_name": "abox_rail",
            "max": 1,
            "min": 0,
            "priority": "error",
            "time_to_latch": 100,
            "time_to_unlatch": 10000,
            "lcd_message": "ABox Rail Down"
        },
        {
            "fault_name": "main_rail",
            "max": 1,
            "min": 0,
            "priority": "error",
            "time_to_latch": 100,
            "time_to_unlatch": 10000,
            "lcd_message": "Main Rail Down"
        },
        {
            "fault_name": "v_crit",
            "max": 1,
            "min": 0,
            "priority": "error",
            "time_to_latch": 100,
            "time_to_unlatch": 10000,
            "lcd_message": "5v_crit down"
        },
        {
