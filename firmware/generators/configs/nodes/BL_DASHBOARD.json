{
    "node_name": "BL_DASHBOARD",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "message_name": "bl_dashboard_resp",
                    "description": "CAN bootloader response for dashboard",
                    "signals": [
                        {"signal_name": "status", "data_type": "uint8_t"},
                        {"signal_name": "detail", "data_type": "uint32_t"}
                    ],
                    "id_override": "0x185",
                    "priority": 0
                },
                {
                    "message_name": "bl_dashboard_info",
                    "description": "CAN bootloader identity and capabilities for dashboard",
                    "signals": [
                        {"signal_name": "protocol_version", "data_type": "uint8_t"},
                        {"signal_name": "git_hash", "data_type": "uint32_t"},
                        {"signal_name": "target_id", "data_type": "uint8_t"},
                        {"signal_name": "flags", "data_type": "uint8_t"}
                    ],
                    "id_override": "0x1C1",
                    "period_ms": 5000,
                    "priority": 4
                }
            ],
            "rx": [
                {"message_name": "bl_dashboard_start"},
                {"message_name": "bl_dashboard_crc"},
                {"message_name": "bl_dashboard_jump"},
                {"message_name": "bl_dashboard_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
