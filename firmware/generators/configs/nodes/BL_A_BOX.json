{
    "node_name": "BL_A_BOX",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN1",
            "tx": [
                {
                    "message_name": "bl_a_box_resp",
                    "description": "CAN bootloader response for A-Box",
                    "signals": [
                        {"signal_name": "status", "data_type": "uint8_t"},
                        {"signal_name": "detail", "data_type": "uint32_t"}
                    ],
                    "id_override": "0x18B",
                    "priority": 0
                }
            ],
            "rx": [
                {"message_name": "bl_a_box_cmd"},
                {"message_name": "bl_a_box_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
