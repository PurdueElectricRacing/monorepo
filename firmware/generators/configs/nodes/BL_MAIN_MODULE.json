{
    "node_name": "BL_MAIN_MODULE",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "message_name": "bl_main_module_resp",
                    "description": "CAN bootloader response for main module",
                    "signals": [
                        {"signal_name": "status", "data_type": "uint8_t"},
                        {"signal_name": "detail", "data_type": "uint32_t"}
                    ],
                    "id_override": "0x182",
                    "priority": 0
                },
                {
                    "message_name": "bl_main_module_info",
                    "description": "CAN bootloader identity and capabilities for main module",
                    "signals": [
                        {"signal_name": "protocol_version", "data_type": "uint8_t"},
                        {"signal_name": "git_hash", "data_type": "uint32_t"},
                        {"signal_name": "target_id", "data_type": "uint8_t"},
                        {"signal_name": "flags", "data_type": "uint8_t"}
                    ],
                    "id_override": "0x1A7",
                    "period_ms": 5000,
                    "priority": 4
                }
            ],
            "rx": [
                {"message_name": "bl_main_module_cmd"},
                {"message_name": "bl_main_module_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
