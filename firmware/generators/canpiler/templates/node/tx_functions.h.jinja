// TX Functions
{% for entry in ctx.tx_entries %}
[[gnu::always_inline]]
static inline void CAN_SEND_{{ entry.msg.name }}(
{% for codec in entry.codecs if not codec.signal.is_reserved %}
    {{ codec.signal.c_type }} value_{{ codec.signal.name }}{{ "," if not loop.last }}
{% endfor %}
) {
    CanMsgTypeDef_t outgoing = {
        .Bus = {{ entry.periph }},
        {% if entry.msg.is_extended %}
        .ExtId = {{ entry.msg.macro_name }}_MSG_ID,
        .IDE=true,
        {% else %}
        .StdId = {{ entry.msg.macro_name }}_MSG_ID,
        .IDE = false,
        {% endif %}
        .DLC = {{ entry.msg.macro_name }}_DLC,
        .Data = {0}
    };

    uint64_t payload = 0;
    {% for codec in entry.codecs %}
    {% if codec.signal.is_reserved %}
    uint64_t sig_raw_{{ codec.signal.name }} = 0;
    {% elif codec.is_float32 %}
    uint64_t sig_raw_{{ codec.signal.name }} = CAN_float32_to_raw(value_{{ codec.signal.name }});
    {% else %}
    uint64_t sig_raw_{{ codec.signal.name }} = (uint64_t)value_{{ codec.signal.name }};
    {% endif %}
    payload = CAN_pack_raw_signal(payload, sig_raw_{{ codec.signal.name }}, {{ codec.signal.mask|to_c_hex }}, {{ codec.signal.bit_shift }}, {{ codec.bswap_width }});
    {% endfor %}

    CAN_store_payload_u64(outgoing.Data, payload, {{ entry.msg.macro_name }}_DLC);

    {{ entry.enqueue_func }}(&outgoing);
}

{% endfor %}
