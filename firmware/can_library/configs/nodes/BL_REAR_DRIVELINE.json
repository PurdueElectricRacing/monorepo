{
    "node_name": "BL_REAR_DRIVELINE",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "msg_name": "bl_rear_driveline_resp",
                    "msg_desc": "CAN bootloader response for rear driveline",
                    "signals": [
                        {"sig_name": "status", "type": "uint8_t"},
                        {"sig_name": "detail", "type": "uint32_t"}
                    ],
                    "msg_id_override": "0x191",
                    "msg_priority": 0
                },
                {
                    "msg_name": "bl_rear_driveline_info",
                    "msg_desc": "CAN bootloader identity and capabilities for rear driveline",
                    "signals": [
                        {"sig_name": "protocol_version", "type": "uint8_t"},
                        {"sig_name": "git_hash", "type": "uint32_t"},
                        {"sig_name": "target_id", "type": "uint8_t"},
                        {"sig_name": "flags", "type": "uint8_t"}
                    ],
                    "msg_id_override": "0x1C5",
                    "msg_period": 5000,
                    "msg_priority": 4
                }
            ],
            "rx": [
                {"msg_name": "bl_rear_driveline_start"},
                {"msg_name": "bl_rear_driveline_crc"},
                {"msg_name": "bl_rear_driveline_jump"},
                {"msg_name": "bl_rear_driveline_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
