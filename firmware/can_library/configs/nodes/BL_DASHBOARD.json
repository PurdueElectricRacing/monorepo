{
    "node_name": "BL_DASHBOARD",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "msg_name": "bl_dashboard_resp",
                    "msg_desc": "CAN bootloader response for dashboard",
                    "signals": [
                        {"sig_name": "status", "type": "uint8_t"},
                        {"sig_name": "detail", "type": "uint32_t"}
                    ],
                    "msg_id_override": "0x185",
                    "msg_priority": 0
                },
                {
                    "msg_name": "bl_dashboard_info",
                    "msg_desc": "CAN bootloader identity and capabilities for dashboard",
                    "signals": [
                        {"sig_name": "protocol_version", "type": "uint8_t"},
                        {"sig_name": "git_hash", "type": "uint32_t"},
                        {"sig_name": "target_id", "type": "uint8_t"},
                        {"sig_name": "flags", "type": "uint8_t"}
                    ],
                    "msg_id_override": "0x1C1",
                    "msg_period": 5000,
                    "msg_priority": 4
                }
            ],
            "rx": [
                {"msg_name": "bl_dashboard_start"},
                {"msg_name": "bl_dashboard_crc"},
                {"msg_name": "bl_dashboard_jump"},
                {"msg_name": "bl_dashboard_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
