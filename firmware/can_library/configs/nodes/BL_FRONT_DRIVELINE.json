{
    "node_name": "BL_FRONT_DRIVELINE",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "msg_name": "bl_front_driveline_resp",
                    "msg_desc": "CAN bootloader response for front driveline",
                    "signals": [
                        {"sig_name": "status", "type": "bootloader_status_t"},
                        {"sig_name": "detail", "type": "uint32_t"}
                    ],
                    "msg_id_override": "0x18E",
                    "msg_priority": 0
                },
                {
                    "msg_name": "bl_front_driveline_info",
                    "msg_desc": "CAN bootloader identity and capabilities for front driveline",
                    "signals": [
                        {"sig_name": "protocol_version", "type": "uint8_t"},
                        {"sig_name": "git_hash", "type": "uint32_t"},
                        {"sig_name": "target_id", "type": "bootloader_target_id_t"},
                        {"sig_name": "flags", "type": "uint8_t"}
                    ],
                    "msg_id_override": "0x1C4",
                    "msg_period": 5000,
                    "msg_priority": 4
                }
            ],
            "rx": [
                {"msg_name": "bl_front_driveline_start"},
                {"msg_name": "bl_front_driveline_crc"},
                {"msg_name": "bl_front_driveline_jump"},
                {"msg_name": "bl_front_driveline_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
