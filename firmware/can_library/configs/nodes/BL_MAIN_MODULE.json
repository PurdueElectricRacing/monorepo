{
    "node_name": "BL_MAIN_MODULE",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "msg_name": "bl_main_module_resp",
                    "msg_desc": "CAN bootloader response for main module",
                    "signals": [
                        {"sig_name": "status", "type": "uint8_t"},
                        {"sig_name": "detail", "type": "uint32_t"}
                    ],
                    "msg_id_override": "0x182",
                    "msg_priority": 0
                },
                {
                    "msg_name": "bl_main_module_info",
                    "msg_desc": "CAN bootloader identity and capabilities for main module",
                    "signals": [
                        {"sig_name": "protocol_version", "type": "uint8_t"},
                        {"sig_name": "git_hash", "type": "uint32_t"},
                        {"sig_name": "target_id", "type": "uint8_t"},
                        {"sig_name": "flags", "type": "uint8_t"}
                    ],
                    "msg_id_override": "0x1C0",
                    "msg_period": 5000,
                    "msg_priority": 4
                }
            ],
            "rx": [
                {"msg_name": "bl_main_module_start"},
                {"msg_name": "bl_main_module_crc"},
                {"msg_name": "bl_main_module_jump"},
                {"msg_name": "bl_main_module_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
