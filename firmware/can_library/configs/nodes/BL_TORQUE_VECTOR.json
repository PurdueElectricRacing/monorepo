{
    "node_name": "BL_TORQUE_VECTOR",
    "busses": {
        "VCAN": {
            "peripheral": "FDCAN2",
            "tx": [
                {
                    "msg_name": "bl_torque_vector_resp",
                    "msg_desc": "CAN bootloader response for torque vector",
                    "signals": [
                        {"sig_name": "status", "type": "uint8_t"},
                        {"sig_name": "detail", "type": "uint32_t"}
                    ],
                    "msg_id_override": "0x188",
                    "msg_priority": 0
                }
            ],
            "rx": [
                {"msg_name": "bl_torque_vector_cmd"},
                {"msg_name": "bl_torque_vector_data"}
            ]
        }
    },
    "fault_library_enabled": false
}
