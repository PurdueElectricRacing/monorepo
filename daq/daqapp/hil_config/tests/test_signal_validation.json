{
	"$schema": "../schema.json",

	"name": "Pack sanity check",
	"description": "Verify thermistor response",

	"tx": [
		{
			"timestamp": 15,
			"msg_name": "pack_analog",
			"signals": {
				"pack_voltage": 540.0,
				"pack_current": 10.0
			}
		}
	],
	"expect": [
		{
			"window": [0, 10000],
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": [30.0, 40.0]
			},
			"accept": "last"
		}
	]
}