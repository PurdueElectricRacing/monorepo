		{
			"window": [2000, 2050],
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": [30.0, 40.0]
			}
		},

		{
			"window": [2050, 2100],
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": [10.0, 20.0]
			}
		},

		{
			"window": [2100, 2150],
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": [60.0, 70.0]
			}
		}
	]
}