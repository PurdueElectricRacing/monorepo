{
	"$schema": "../schema.json",

	"name": "Pack sanity check",
	"description": "Verify thermistor response",

	"tx": [
		{
			"timestamp": 7500,
			"msg_name": "pack_analog",
			"signals": {
				"pack_voltage": 540.0,
				"pack_current": 10.0
			}
		},

		{
			"timestamp": 2000,
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": 35.0,
				"module_num": 1,
    			"thermistor_num": 2,
				"is_board_temp": 0
			}
		},

		{
			"timestamp": 2050,
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": 15.0,
				"module_num": 1,
    			"thermistor_num": 2,
				"is_board_temp": 0
			}
		},

		{
			"timestamp": 2100,
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": 62.3,
				"module_num": 1,
    			"thermistor_num": 2,
				"is_board_temp": 0
			}
		}
	],
	"expect": [
		{
			"window": [0, 20000],
			"msg_name": "thermistor_telemetry",
			"signals": {
				"temperature": [30.0, 40.0]
