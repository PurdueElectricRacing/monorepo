CM_ BU_ G4_TESTING "";
CM_ BO_ 1 "CANpiler offset/scale validation. Includes offset-only, scale-only, both, and neither for g4_testing <-> daqapp testing.";
CM_ SG_ 1 status "No scale or offset: packed in u8.";
CM_ SG_ 1 pressure "Scale and offset: unsigned range packed in u8. Scale: 2kPa, Offset: 20kPa.";
